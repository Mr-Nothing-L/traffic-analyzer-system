# ============================================
# Traffic Analyzer - LLM/VLM API Configuration
# Copy this file to .env and fill in your actual API keys.
# ============================================

# --- VLM Provider Selection (single provider, backward compatible) ---
# Supported: anthropic, google, aliyun
# If LLM_PROVIDER_N_* variables are present, these single-provider variables
# are ignored in favor of the multi-provider list below.
VLM_PROVIDER=anthropic

# --- Multi-provider failover configuration (recommended) ---
# Order matters: provider 0 is the primary, provider 1 is the first fallback.
# Add LLM_PROVIDER_2_*, LLM_PROVIDER_3_*, etc. for additional fallbacks.
LLM_PROVIDER_0_PROVIDER=anthropic
LLM_PROVIDER_0_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER_0_MODEL=claude-sonnet-4-6
# LLM_PROVIDER_0_BASE_URL=https://api.anthropic.com/v1/

LLM_PROVIDER_1_PROVIDER=aliyun
LLM_PROVIDER_1_API_KEY=your_aliyun_api_key_here
LLM_PROVIDER_1_MODEL=qwen-vl-max
LLM_PROVIDER_1_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google (Gemini) ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-pro

# --- Aliyun (Qwen-VL) ---
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_MODEL=qwen-vl-max
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- LLM Inference ---
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_ENABLE_CACHE=true
LLM_CACHE_MAX_SIZE=128

# Disk-based persistent cache (cross-process, for batch_infer)
TRAFFIC_ANALYZER_DISK_CACHE=./output/.vlm_cache.db
TRAFFIC_ANALYZER_DISK_CACHE_MAX_ENTRIES=2000

# --- ExpertAgent reflection (self-consistency check) ---
# Set to false to disable the text-only reflection step after each ExpertAgent detection.
# EXPERT_ENABLE_REFLECTION=true

# --- Grounding verification (post-adjudication anchoring check) ---
# Set to false to disable the step that overturns hallucinated positives
# whose key elements cannot be anchored in the raw frames.
# GROUNDING_CHECK_ENABLE=true

# --- Prefilter (sample quality gate) ---
PREFILTER_ENABLE=true
PREFILTER_BRIGHTNESS_THRESHOLD=50
PREFILTER_MIN_BITRATE=10000
PREFILTER_MIN_DURATION_SEC=5.0
PREFILTER_MAX_DURATION_SEC=15.0

# ============================================
# Agent 运行时(TS agent server + Python 工具服务 + web 代理)
# ============================================
# 以下 AGENT_* 变量在 agent/src/server/main.ts 启动最早处从本文件读入 process.env
# (只补缺,不覆盖已导出的 shell 变量),因此独立 tsx/web 拉起/shell 导出三条路径
# 行为一致。runtime.py 显式注入的 AGENT_PORT/TOOLSERVER_URL/AGENT_RESTORE_WORKSPACES
# 会作为覆盖生效。

# --- Web 层子进程管理(traffic_analyzer/web/agentproxy/runtime.py) ---
# agent 运行时总开关:默认开启,0/false/no/off 关闭(web 启动时不再拉起两个子进程)
AGENT_RUNTIME_ENABLE=true
# web 拉起 TS agent 服务使用的端口(默认 8602;多实例并存时覆盖以免降级到外部旧实例)
AGENT_RUNTIME_AGENT_PORT=8602
# web 拉起 Python 工具服务使用的端口(默认 8601)
AGENT_RUNTIME_TOOLSERVER_PORT=8601

# --- TS agent server(agent/src/server/main.ts,独立运行时生效) ---
# agent server 监听端口(默认 8602;由 web 拉起时以 AGENT_RUNTIME_AGENT_PORT 注入)
AGENT_PORT=8602
# agent server 监听地址(默认 127.0.0.1,仅回环)
AGENT_HOST=127.0.0.1
# 单次 LLM 调用的 max_tokens 上限。未设置时,若 LLM_MAX_TOKENS/LLM_PROVIDER_0_MAX_TOKENS
# 小于 16384,会打印 warning 并兜底到 16384(qwen3 类 thinking 模型推理 token 也计入,
# 检测 agent 需要长思考 + 大型结构化输出,过小会把 tool call arguments 截断)。
# 想严格使用较小值时,请在本变量显式设置。
# AGENT_MAX_TOKENS=16384
# 上下文窗口 token 数(默认 262144 = 256k,对应本地 qwen3.8-27b-fp8 的 max_model_len;用量达 85% 自动摘要压缩)
# AGENT_CONTEXT_TOKENS=262144
# qwen3 类 thinking 模型思考开关:默认开启;0/false/no/off 关闭。关闭后简单问题 completion
# 大幅下降,但摘要等不需要长推理的调用可省一半以上时间。
# AGENT_ENABLE_THINKING=true
# 逗号分隔的 workspace 目录,agent server 独立运行时从其 .agent/sessions.db 恢复历史会话(可选;由 web 拉起时不需要)
# AGENT_RESTORE_WORKSPACES=
# 对话附件上传大小上限 MB(默认 500,可小数;web 代理 /api/agent/uploads 校验,超限 413)
# AGENT_UPLOAD_MAX_MB=500

# --- Python 视频工具服务(traffic_analyzer/toolserver) ---
# 工具服务监听端口(默认 8601;由 web 拉起时以 AGENT_RUNTIME_TOOLSERVER_PORT 经 --port 传入)
TOOLSERVER_PORT=8601
# TS agent 访问工具服务的地址(默认 http://127.0.0.1:8601;由 web 拉起时自动注入,独立运行 agent 时需与工具服务端口一致)
TOOLSERVER_URL=http://127.0.0.1:8601
