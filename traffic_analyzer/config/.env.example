# ============================================
# Traffic Analyzer - LLM/VLM API Configuration
# Copy this file to .env and fill in your actual API keys.
# ============================================

# --- VLM Provider Selection (single provider, backward compatible) ---
# Supported: anthropic, google, aliyun
# If LLM_PROVIDER_N_* variables are present, these single-provider variables
# are ignored in favor of the multi-provider list below.
VLM_PROVIDER=anthropic

# --- Multi-provider failover configuration (recommended) ---
# Order matters: provider 0 is the primary, provider 1 is the first fallback.
# Add LLM_PROVIDER_2_*, LLM_PROVIDER_3_*, etc. for additional fallbacks.
LLM_PROVIDER_0_PROVIDER=anthropic
LLM_PROVIDER_0_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER_0_MODEL=claude-sonnet-4-6
# LLM_PROVIDER_0_BASE_URL=https://api.anthropic.com/v1/

LLM_PROVIDER_1_PROVIDER=aliyun
LLM_PROVIDER_1_API_KEY=your_aliyun_api_key_here
LLM_PROVIDER_1_MODEL=qwen-vl-max
LLM_PROVIDER_1_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google (Gemini) ---
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-pro

# --- Aliyun (Qwen-VL) ---
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_MODEL=qwen-vl-max
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- LLM Inference ---
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_ENABLE_CACHE=true
LLM_CACHE_MAX_SIZE=128

# Disk-based persistent cache (cross-process, for batch_infer)
TRAFFIC_ANALYZER_DISK_CACHE=./output/.vlm_cache.db
TRAFFIC_ANALYZER_DISK_CACHE_MAX_ENTRIES=2000

# --- ExpertAgent reflection (self-consistency check) ---
# Set to false to disable the text-only reflection step after each ExpertAgent detection.
# EXPERT_ENABLE_REFLECTION=true

# --- Grounding verification (post-adjudication anchoring check) ---
# Set to false to disable the step that overturns hallucinated positives
# whose key elements cannot be anchored in the raw frames.
# GROUNDING_CHECK_ENABLE=true

# --- Prefilter (sample quality gate) ---
PREFILTER_ENABLE=true
PREFILTER_BRIGHTNESS_THRESHOLD=50
PREFILTER_MIN_BITRATE=10000
PREFILTER_MIN_DURATION_SEC=5.0
PREFILTER_MAX_DURATION_SEC=15.0
